---
import type { DataFamily } from "@/design/tokens";
import { linear } from "./scale";

/** Where most of the country sits on an indicator: a band from `from` to `to` and a marked middle, on its range. */
interface Props {
  family: DataFamily;
  low: number;
  from: number;
  middle: number;
  to: number;
  high: number;
  format: (value: number) => string;
  middleLabel: string;
  summary: string;
}

const { family, low, from, middle, to, high, format, middleLabel, summary } = Astro.props;
const x = linear([low, high], [0, 100]);
const color = `var(--ia-family-${family})`;
const band = `var(--ia-viz-${family}-3)`;
---

<figure class="pt-8 pb-1" style={`--series-color: ${color}`}>
  <figcaption class="sr-only">{summary}</figcaption>
  <div class="relative mx-2 h-10" aria-hidden="true">
    <div class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-line-strong"></div>
    <div class="absolute top-1/2 h-3 -translate-y-1/2 rounded-pill" style={`left: ${x(from)}%; width: ${x(to) - x(from)}%; background-color: ${band}`}></div>
    <span class="chart-dot top-1/2" style={`left: ${x(middle)}%`}></span>
    <span class="absolute bottom-full -translate-x-1/2 pb-1 text-xs whitespace-nowrap text-ink" style={`left: ${x(middle)}%`}>
      {middleLabel} {format(middle)}
    </span>
    <span class="absolute top-full -translate-x-1/2 pt-1 text-2xs text-ink-subtle" style={`left: ${x(from)}%`}>{format(from)}</span>
    <span class="absolute top-full -translate-x-1/2 pt-1 text-2xs text-ink-subtle" style={`left: ${x(to)}%`}>{format(to)}</span>
  </div>
</figure>
