---
import AccountShell from "@/components/account/AccountShell.astro";
import ProjectApp from "./ProjectApp";
import { pickProjectCatalog } from "./i18n";
import { catalogs, createTranslator, localizePath, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { t } = createTranslator(locale);
---

<AccountShell locale={locale} section="projects" title={t("project.metaTitle")}>
  <ProjectApp
    client:load
    locale={locale}
    catalog={pickProjectCatalog(catalogs[locale])}
    signInPath={localizePath("/login/", locale)}
    projectsPath={localizePath("/account/projects/", locale)}
    zonePath={localizePath("/zone/", locale)}
  />
</AccountShell>
