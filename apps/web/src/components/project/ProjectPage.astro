---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import SiteNavPanels from "@/components/site/SiteNavPanels.astro";
import ProjectApp from "./ProjectApp";
import { pickProjectCatalog } from "./i18n";
import { catalogs, createTranslator, localizePath, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { t } = createTranslator(locale);
---

<BaseLayout locale={locale} title={t("project.metaTitle")} description={t("meta.description")} noindex>
  <SiteHeader locale={locale} />
  <main id="main" class="mx-auto w-full max-w-3xl px-gutter py-12">
    <ProjectApp
      client:load
      locale={locale}
      catalog={pickProjectCatalog(catalogs[locale])}
      signInPath={localizePath("/login/", locale)}
      projectsPath={localizePath("/account/#projects", locale)}
      zonePath={localizePath("/zone/", locale)}
    />
  </main>
  <SiteNavPanels locale={locale} />
</BaseLayout>
