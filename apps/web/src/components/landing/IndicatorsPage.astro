---
import SitePage from "@/layouts/SitePage.astro";
import IndicatorAtlas from "./IndicatorAtlas.astro";
import { createTranslator, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { t } = createTranslator(locale);
---

<SitePage locale={locale} title={t("indicatorsPage.metaTitle")} description={t("indicatorsPage.metaDescription")}>
  <IndicatorAtlas locale={locale} as="page" />
</SitePage>

<script>
  import { initCharts } from "@/scripts/charts";
  initCharts();
</script>
