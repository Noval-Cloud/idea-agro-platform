---
import { createTranslator, type Locale, type MessageKey } from "@/i18n";
import { articles, articleUrl, citedBy, frameworkArticles, type Article } from "@/data/articles";
import { indicatorIds, indicators } from "@/data/indicators";
import { familyBackground } from "@/design/family-classes";
import { isHidden } from "@/data/shown";
import { shortCitation } from "@/lib/citation";
import UnavailableInfo from "@/components/indicators/UnavailableInfo.astro";

interface Props {
  locale: Locale;
}
const { t } = createTranslator(Astro.props.locale);
const withPeriod = (text: string) => (text.endsWith(".") ? text : `${text}.`);
const cite = (article: Article) => {
  const { key, values } = shortCitation(article);
  return t(`science.${key}`, values);
};

// Each article with the indicators it backs, newest first, as the store keeps them.
const backed = articles
  .filter((a) => !a.framework)
  .map((a) => ({ ...a, indicators: indicatorIds.filter((id) => citedBy(a.id).includes(id)) }));
---

<section id="science" class="border-b border-line py-section" aria-labelledby="science-title">
  <div class="grid gap-x-12 gap-y-10 px-gutter lg:grid-cols-12">
    <div class="lg:col-span-4">
      <h2 id="science-title" class="font-display text-3xl font-medium tracking-tight text-ink">{t("science.title")}</h2>
      <p class="mt-5 text-base text-ink-muted">{t("science.lead")}</p>
      {
        frameworkArticles.length > 0 && (
          <div class="mt-8 rounded-lg border border-line bg-surface p-6 lg:sticky lg:top-24">
            <h3 class="text-xs font-medium text-ink-subtle">{t("science.frameworkLabel")}</h3>
            <ol class="mt-3 grid gap-4">
              {frameworkArticles.map((a) => (
                <li>
                  <p class="text-base leading-snug text-ink" lang={a.lang}>{a.title}</p>
                  {/* One line, so five entries fit the sticky card: the link truncates first. */}
                  <p class="mt-1 flex gap-1 text-sm text-ink-muted">
                    <span class="max-w-full shrink-0 truncate">{cite(a)}.</span>
                    {articleUrl(a) && (
                      <a class="min-w-0 truncate text-link underline-offset-(--ia-link-underline-offset) hover:underline" href={articleUrl(a)} rel="noopener" target="_blank">
                        {a.url ? t("science.link") : t("science.frameworkDoi")}
                        <span class="sr-only"> {t("a11y.externalLink")}</span>
                      </a>
                    )}
                  </p>
                </li>
              ))}
            </ol>
          </div>
        )
      }
    </div>

    <div class="lg:col-span-8">
      <h3 class="text-sm font-medium text-ink-subtle">{t("science.papersLabel")}</h3>
      <ol class="mt-4 divide-y divide-line border-y border-line">
        {
          backed.map((r) => (
            <li class="grid gap-2 py-5 sm:flex sm:gap-6">
              <span class="w-14 shrink-0 font-display text-lg text-ink-subtle">{r.year}</span>
              <div class="max-w-measure">
                <p class="text-base text-ink" lang={r.lang}>{r.title}</p>
                <p class="mt-1 text-sm text-ink-muted">
                  {withPeriod(r.authors)} {r.source}.
                  {articleUrl(r) && (
                    <a class="ml-1 text-link underline-offset-(--ia-link-underline-offset) hover:underline" href={articleUrl(r)} rel="noopener" target="_blank">
                      {r.url ? t("science.link") : t("science.doi", { doi: r.doi ?? "" })}
                      <span class="sr-only"> {t("a11y.externalLink")}</span>
                    </a>
                  )}
                </p>
                {r.indicators.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-2" aria-label={t("science.backsLabel")}>
                    {r.indicators.map((id) =>
                      isHidden(id) ? (
                        <li class="inline-flex items-center gap-0.5">
                          <span class="inline-flex items-center gap-1.5 rounded-pill border border-dashed border-line px-2.5 py-0.5 text-xs text-ink-subtle">
                            <span class:list={["size-2 rounded-xs opacity-40", familyBackground[indicators[id].family]]} aria-hidden="true" />
                            {t(`indicators.items.${id}.name` as MessageKey)}
                          </span>
                          <UnavailableInfo locale={Astro.props.locale} indicator={id} size="sm" />
                        </li>
                      ) : (
                        <li class="inline-flex items-center gap-1.5 rounded-pill border border-line px-2.5 py-0.5 text-xs text-ink-muted">
                          <span class:list={["size-2 rounded-xs", familyBackground[indicators[id].family]]} aria-hidden="true" />
                          {t(`indicators.items.${id}.name` as MessageKey)}
                        </li>
                      ),
                    )}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
