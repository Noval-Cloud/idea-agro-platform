---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import SiteNavPanels from "@/components/site/SiteNavPanels.astro";
import InvitationApp from "./InvitationApp";
import { pickInvitationCatalog } from "./i18n";
import { catalogs, createTranslator, localizePath, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { t } = createTranslator(locale);
---

<BaseLayout locale={locale} title={t("invitation.metaTitle")} description={t("meta.description")} noindex>
  <SiteHeader locale={locale} />
  <main id="main" class="px-gutter py-16 sm:py-24">
    <InvitationApp
      client:load
      locale={locale}
      catalog={pickInvitationCatalog(catalogs[locale])}
      signInPath={localizePath("/login/", locale)}
      projectPath={localizePath("/project/", locale)}
      projectsPath={localizePath("/account/projects/", locale)}
    />
  </main>
  <SiteNavPanels locale={locale} />
</BaseLayout>
