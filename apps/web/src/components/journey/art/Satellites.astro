---
import { Image } from "astro:assets";
import { createTranslator, type Locale } from "@/i18n";
import { STAGE } from "./ground";
import ppna from "@/assets/maps/ppna-dark.webp";

interface Props {
  locale: Locale;
}
const { t } = createTranslator(Astro.props.locale);
/*
 * A satellite pass seen from above: the ground track crosses the country, the sensor's swath
 * sweeps over it, and the productivity map fills in behind the swath.
 */
const track = { from: [36, 74], to: [604, 326] } as const;
---

<div class="relative aspect-16/10 w-full overflow-hidden" aria-hidden="true">
  <Image
    src={ppna}
    alt=""
    widths={[240, 360, 480]}
    sizes="(min-width: 64rem) 24vw, 46vw"
    quality={62}
    class="j-ghost absolute top-1/2 left-1/2 h-auto -translate-x-1/2 -translate-y-1/2"
    style="width: 38%"
  />
  <Image
    src={ppna}
    alt=""
    widths={[240, 360, 480]}
    sizes="(min-width: 64rem) 24vw, 46vw"
    quality={62}
    class="j-reveal absolute top-1/2 left-1/2 h-auto -translate-x-1/2 -translate-y-1/2"
    style="width: 38%"
  />
  <svg viewBox={`0 0 ${STAGE.width} ${STAGE.height}`} class="absolute inset-0 size-full">
    <path class="j-stroke j-dash" d={`M${track.from.join(",")}L${track.to.join(",")}`} />
    <g class="j-pass" style={`--x0: ${track.from[0]}px; --y0: ${track.from[1]}px; --x1: ${track.to[0]}px; --y1: ${track.to[1]}px`}>
      <!-- The swath: a band across the track, as wide as the sensor sees. -->
      <path class="j-swath" d="M0,-150L36,-150L36,150L0,150Z" transform="rotate(24)" />
      <path class="j-stroke j-faint" d="M36,-150L36,150" transform="rotate(24)" />
      <g class="j-stroke j-strong" transform="rotate(24)">
        <rect x="-8" y="-6" width="16" height="12" rx="1.5" />
        <path d="M-8,0H-24M8,0H24" />
        <rect x="-42" y="-6" width="18" height="12" class="j-panel" />
        <rect x="24" y="-6" width="18" height="12" class="j-panel" />
      </g>
    </g>
  </svg>
  <p class="j-rise j-tag absolute" style="left: 4%; top: 6%; --d: 1">{t("journey.scenes.satellites.sensor")}</p>
</div>
