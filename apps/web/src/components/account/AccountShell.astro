---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import SiteNavPanels from "@/components/site/SiteNavPanels.astro";
import AccountNav from "./AccountNav";
import { accountPaths, pickAccountCatalog, type AccountSection, type AccountSubpage } from "./i18n";
import { catalogs, createTranslator, localizePath, type Locale } from "@/i18n";

/*
 * Every page of the account: its navigation in a column the height of the page, as the explorer's panel, and
 * the page's content beside it. On phones the navigation is a row of tabs above the content.
 */
interface Props {
  locale: Locale;
  section: AccountSection;
  subpage?: AccountSubpage;
  title: string;
  /** False when the page names itself, as a project's page does with the project's name. */
  heading?: boolean;
}
const { locale, section, subpage, title, heading = true } = Astro.props;
const { t } = createTranslator(locale);
const paths = accountPaths(localizePath("/account/", locale));
---

<BaseLayout locale={locale} title={title} description={t("meta.description")} noindex>
  <SiteHeader locale={locale} />
  <div class="flex min-h-(--ia-layout-app) flex-col lg:flex-row">
    <aside
      class="shrink-0 border-b border-line bg-surface px-gutter py-3 lg:w-(--ia-layout-nav) lg:border-r lg:border-b-0 lg:py-6"
    >
      <AccountNav
        client:load
        locale={locale}
        catalog={pickAccountCatalog(catalogs[locale])}
        section={section}
        subpage={subpage}
        sectionPaths={paths.sections}
        subpagePaths={paths.subpages}
      />
    </aside>
    <main id="main" class="min-w-0 grow px-gutter pb-16 lg:px-10">
      {heading && <h1 class="sr-only">{t(`account.sections.${section}`)}</h1>}
      <slot />
    </main>
  </div>
  <SiteNavPanels locale={locale} />
</BaseLayout>
