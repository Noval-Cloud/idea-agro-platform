---
import AccountShell from "./AccountShell.astro";
import AccountApp from "./AccountApp";
import { accountPaths, pickAccountCatalog, type AccountSection, type AccountSubpage } from "./i18n";
import { catalogs, createTranslator, localizePath, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
  section: AccountSection;
  subpage?: AccountSubpage;
}
const { locale, section, subpage } = Astro.props;
const { t } = createTranslator(locale);
const paths = accountPaths(localizePath("/account/", locale));
const named = subpage ? t(`account.subpages.${subpage}`) : section === "profile" ? null : t(`account.sections.${section}`);
const title = named ? `${named} · ${t("meta.accountTitle")}` : t("meta.accountTitle");
---

<AccountShell locale={locale} section={section} subpage={subpage} title={title}>
  <AccountApp
    client:load
    locale={locale}
    catalog={pickAccountCatalog(catalogs[locale])}
    section={section}
    subpage={subpage}
    sectionPaths={paths.sections}
    signInPath={localizePath("/login/", locale)}
    homePath={localizePath("/", locale)}
    zonePath={localizePath("/zone/", locale)}
    projectPath={localizePath("/project/", locale)}
    outlinePath={localizePath("/outline/", locale)}
    explorePath={localizePath("/explore/?reg=mine", locale)}
    mapPath={localizePath("/explore/", locale)}
  />
</AccountShell>
