---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import SiteNavPanels from "@/components/site/SiteNavPanels.astro";
import AccountApp from "./AccountApp";
import { pickAccountCatalog } from "./i18n";
import { catalogs, createTranslator, localizePath, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { t } = createTranslator(locale);
---

<BaseLayout locale={locale} title={t("meta.accountTitle")} description={t("meta.description")} noindex>
  <SiteHeader locale={locale} />
  <main id="main" class="mx-auto w-full max-w-3xl px-gutter py-12">
    <h1 class="font-display text-3xl font-medium tracking-tight text-ink">{t("account.title")}</h1>
    <div class="mt-8">
      <AccountApp
        client:load
        locale={locale}
        catalog={pickAccountCatalog(catalogs[locale])}
        signInPath={localizePath("/login/", locale)}
        homePath={localizePath("/", locale)}
      />
    </div>
  </main>
  <SiteNavPanels locale={locale} />
</BaseLayout>
