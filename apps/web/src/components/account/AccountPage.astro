---
import AccountShell from "./AccountShell.astro";
import AccountApp from "./AccountApp";
import { accountSections, pickAccountCatalog, type AccountSection } from "./i18n";
import { catalogs, createTranslator, localizePath, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
  section: AccountSection;
}
const { locale, section } = Astro.props;
const { t } = createTranslator(locale);
const account = localizePath("/account/", locale);
const sectionPaths = Object.fromEntries(
  accountSections.map((s) => [s, s === "profile" ? account : `${account}${s}/`]),
) as Record<AccountSection, string>;
const title =
  section === "profile" ? t("meta.accountTitle") : `${t(`account.sections.${section}`)} · ${t("meta.accountTitle")}`;
---

<AccountShell locale={locale} section={section} title={title}>
  <AccountApp
    client:load
    locale={locale}
    catalog={pickAccountCatalog(catalogs[locale])}
    section={section}
    sectionPaths={sectionPaths}
    signInPath={localizePath("/login/", locale)}
    homePath={localizePath("/", locale)}
    zonePath={localizePath("/zone/", locale)}
    projectPath={localizePath("/project/", locale)}
    explorePath={localizePath("/explore/?reg=mine", locale)}
  />
</AccountShell>
