---
/**
 * Sign-in provider marks. Their colors are fixed by each provider's brand guidelines,
 * so they are the one place where fills are not design tokens.
 */
interface Props {
  provider: "google" | "microsoft" | "orcid" | "github";
}
const { provider } = Astro.props;
---

{
  provider === "google" && (
    <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
      <path fill="#4285F4" d="M23.52 12.27c0-.85-.08-1.67-.22-2.45H12v4.64h6.46a5.52 5.52 0 0 1-2.4 3.62v3h3.88c2.27-2.09 3.58-5.17 3.58-8.81z" />
      <path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.94-2.91l-3.88-3.01c-1.07.72-2.45 1.15-4.06 1.15-3.12 0-5.77-2.11-6.71-4.95H1.28v3.11A12 12 0 0 0 12 24z" />
      <path fill="#FBBC05" d="M5.29 14.28A7.2 7.2 0 0 1 4.91 12c0-.79.14-1.56.38-2.28V6.61H1.28A12 12 0 0 0 0 12c0 1.94.46 3.77 1.28 5.39l4.01-3.11z" />
      <path fill="#EA4335" d="M12 4.77c1.76 0 3.34.6 4.58 1.79l3.44-3.44A11.97 11.97 0 0 0 12 0 12 12 0 0 0 1.28 6.61l4.01 3.11C6.23 6.88 8.88 4.77 12 4.77z" />
    </svg>
  )
}
{
  provider === "microsoft" && (
    <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
      <path fill="#F25022" d="M1 1h10.5v10.5H1z" />
      <path fill="#7FBA00" d="M12.5 1H23v10.5H12.5z" />
      <path fill="#00A4EF" d="M1 12.5h10.5V23H1z" />
      <path fill="#FFB900" d="M12.5 12.5H23V23H12.5z" />
    </svg>
  )
}
{
  provider === "orcid" && (
    <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
      <circle cx="12" cy="12" r="12" fill="#A6CE39" />
      <path fill="#FFFFFF" d="M8.3 17.6H6.85V7.5H8.3zm2.13-10.1h3.9c3.72 0 5.35 2.66 5.35 5.05 0 2.6-2.02 5.05-5.33 5.05h-3.92zm1.45 8.8h2.3c3.28 0 4.03-2.49 4.03-3.75 0-2.05-1.31-3.75-4.17-3.75h-2.16zM8.53 5.4a.95.95 0 1 1-1.9 0 .95.95 0 0 1 1.9 0z" />
    </svg>
  )
}
{
  provider === "github" && (
    <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true">
      <path
        fill="currentColor"
        d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3"
      />
    </svg>
  )
}
