---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import SiteNavPanels from "@/components/site/SiteNavPanels.astro";
import ExplorerApp from "./ExplorerApp";
import ThemedImage from "@/components/media/ThemedImage.astro";
import type { ImageMetadata } from "astro";
import { openingIndicator, shownIds } from "@/data/shown";
import { pickAppCatalog } from "./lib/i18n";
import { catalogs, createTranslator, localizePath, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { t } = createTranslator(locale);
// The picture of the map the explorer opens on.
const maps = import.meta.glob<{ default: ImageMetadata }>("/src/assets/maps/*.webp", { eager: true });
const light = maps[`/src/assets/maps/${openingIndicator}-light.webp`]?.default;
const dark = maps[`/src/assets/maps/${openingIndicator}-dark.webp`]?.default;
---

<BaseLayout locale={locale} title={t("explorer.metaTitle")} description={t("explorer.metaDescription")}>
  <SiteHeader locale={locale} />
  <main id="main">
    <ExplorerApp
      client:load
      locale={locale}
      catalog={pickAppCatalog(catalogs[locale])}
      zonePath={localizePath("/zone/", locale)}
      signInPath={localizePath("/login/", locale)}
      indicatorsPath={localizePath("/indicators/", locale)}
      shownIndicators={[...shownIds]}
    >
      <!-- Painted before the map loads (and is the page's largest paint): the default background. -->
      {
        light && dark && (
          <ThemedImage
            light={light}
            dark={dark}
            widths={[360, 540, 720]}
            sizes="(min-width: 64rem) 40vw, 80vw"
            alt=""
            priority
            class="size-full object-contain"
          />
        )
      }
    </ExplorerApp>
  </main>
  <SiteNavPanels locale={locale} />
</BaseLayout>
