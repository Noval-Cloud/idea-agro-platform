---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/site/SiteHeader.astro";
import SiteFooter from "@/components/site/SiteFooter.astro";
import SiteNavPanels from "@/components/site/SiteNavPanels.astro";
import ZoneApp from "./ZoneApp";
import { pickAppCatalog } from "@/components/explorer/lib/i18n";
import { catalogs, createTranslator, localizePath, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const { t } = createTranslator(locale);
---

<BaseLayout locale={locale} title={t("zone.metaTitle")} description={t("zone.metaDescription")}>
  <SiteHeader locale={locale} />
  <main id="main" class="min-h-(--ia-layout-app)">
    <ZoneApp
      client:load
      locale={locale}
      catalog={pickAppCatalog(catalogs[locale])}
      explorePath={localizePath("/explore/", locale)}
      signInPath={localizePath("/login/", locale)}
      projectsPath={localizePath("/account/projects/", locale)}
      outlinePath={localizePath("/outline/", locale)}
    />
  </main>
  <SiteFooter locale={locale} />
  <SiteNavPanels locale={locale} />
</BaseLayout>
