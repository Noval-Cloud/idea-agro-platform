GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=

# Account id inside the project, not the email.
SETUP_OPERATOR_SA=
SETUP_STATE_BUCKET=
# Docker repository in Artifact Registry.
SETUP_REGISTRY=

# One API per line.
SETUP_APIS="
"
# One role per line.
SETUP_OPERATOR_ROLES="
"
