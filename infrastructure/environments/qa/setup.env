# Sourced by infrastructure/setup/setup.sh. infrastructure/README.md describes every variable.

# Required. SETUP_REGISTRY is a Docker repository in Artifact Registry.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=
SETUP_REGISTRY=

# Empty takes the default. SETUP_OPERATOR_SA is an account id, not an email.
SETUP_OPERATOR_SA=
SETUP_STATE_BUCKET=

# One item per line. Empty enables or grants nothing.
SETUP_APIS="
"
SETUP_OPERATOR_ROLES="
"
