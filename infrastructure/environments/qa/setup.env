# Sourced by infrastructure/setup/setup.sh. infrastructure/README.md describes every variable.

# Required. SETUP_REGISTRY is a Docker repository in Artifact Registry.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=
SETUP_REGISTRY=

# Empty takes the default. SETUP_OPERATOR_SA is an account id, not an email.
SETUP_OPERATOR_SA=
SETUP_STATE_BUCKET=

# One item per line. SETUP_APIS holds only the project's own APIs: the setup enables its own.
# An empty SETUP_APIS enables no extra API, and an empty SETUP_OPERATOR_ROLES grants nothing.
SETUP_APIS="
"
SETUP_OPERATOR_ROLES="
"
