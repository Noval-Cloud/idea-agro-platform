    "/health": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Whether the service answers",
        "operationId": "get_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/zones/{division}/{zone}/seasonal": {
      "get": {
        "tags": [
          "Zones"
        ],
        "summary": "Seasonal series of a zone",
        "description": "Every composite of the satellite record for the zone, for each indicator with a seasonal series: productivity (`ppna`), absorbed radiation (`apar`) and evapotranspiration (`et`). The response can be cached for an hour.",
        "operationId": "get_zone_seasonal",
        "parameters": [
          {
            "name": "division",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Division",
              "description": "The division the zone belongs to."
            },
            "description": "The division the zone belongs to."
          },
          {
            "name": "zone",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,8}$",
              "description": "The zone's id within its division.",
              "examples": [
                "1806"
              ],
              "title": "Zone"
            },
            "description": "The zone's id within its division."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZoneSeasonal"
                }
              }
            }
          },
          "404": {
            "description": "The zone does not exist in that division.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "A parameter is not valid.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
