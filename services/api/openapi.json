  "components": {
    "schemas": {
      "AccountRole": {
        "type": "string",
        "enum": [
          "client",
          "editor",
          "admin"
        ],
        "title": "AccountRole",
        "description": "`client` is every account; `editor` manages content and `admin` manages accounts. They combine."
      },
      "Division": {
        "type": "string",
        "enum": [
          "seccionales",
          "cuencas-1",
          "cuencas-2",
          "cuencas-3",
          "cuencas-4",
          "cuencas-5"
        ],
        "title": "Division",
        "description": "A predefined division of Uruguay into zones."
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "`ok` when the service answers.",
            "examples": [
              "ok"
            ]
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "The account's id in IDEA-Agro."
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "The email your sign-in provider reports."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Your name, as your sign-in provider reports it."
          },
          "picture": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Picture",
            "description": "URL of your picture, as your sign-in provider reports it."
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/AccountRole"
            },
            "type": "array",
            "title": "Roles",
            "description": "Your roles: always `client`, plus `editor` or `admin` if given."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At",
            "description": "When the account was created, on its first sign-in."
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "name",
          "picture",
          "roles",
          "created_at"
        ],
        "title": "Me",
        "description": "Your account."
      },
      "MultiPolygon": {
        "properties": {
          "type": {
            "type": "string",
            "const": "MultiPolygon",
            "title": "Type"
          },
          "coordinates": {
            "items": {
              "items": {
                "items": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array",
                  "maxItems": 3,
                  "minItems": 2,
                  "description": "Longitude and latitude, in degrees."
                },
                "type": "array",
                "minItems": 4,
                "description": "A closed ring: its first and last positions match."
              },
              "type": "array",
              "minItems": 1
            },
            "type": "array",
            "minItems": 1,
            "title": "Coordinates"
          }
        },
        "type": "object",
        "required": [
          "type",
          "coordinates"
        ],
        "title": "MultiPolygon"
      },
      "Polygon": {
        "properties": {
          "type": {
            "type": "string",
            "const": "Polygon",
            "title": "Type"
          },
          "coordinates": {
            "items": {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array",
                "maxItems": 3,
                "minItems": 2,
                "description": "Longitude and latitude, in degrees."
              },
              "type": "array",
              "minItems": 4,
              "description": "A closed ring: its first and last positions match."
            },
            "type": "array",
            "minItems": 1,
            "title": "Coordinates",
            "description": "The outer ring, then any holes."
          }
        },
        "type": "object",
        "required": [
          "type",
          "coordinates"
        ],
        "title": "Polygon"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "A URI that identifies the kind of problem.",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "A short summary of the kind of problem.",
            "examples": [
              "Not Found"
            ]
          },
          "status": {
            "type": "integer",
            "title": "Status",
            "description": "The HTTP status code.",
            "examples": [
              404
            ]
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail",
            "description": "What went wrong in this request."
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance",
            "description": "The path of the request that failed."
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors",
            "description": "For invalid requests, each parameter that failed validation and why."
          }
        },
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "title": "Problem",
        "description": "An error, as Problem Details (RFC 9457)."
      },
      "SavedZoneFeature": {
        "properties": {
          "type": {
            "type": "string",
            "const": "Feature",
