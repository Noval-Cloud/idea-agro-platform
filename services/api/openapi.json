            "title": "Geometry",
            "description": "A GeoJSON geometry, in WGS 84.",
            "discriminator": {
              "propertyName": "type",
              "mapping": {
                "MultiPolygon": "#/components/schemas/MultiPolygon",
                "Polygon": "#/components/schemas/Polygon"
              }
            }
          }
        },
        "type": "object",
        "required": [
          "id",
          "properties",
          "geometry"
        ],
        "title": "SavedZoneFeature"
      },
      "SavedZoneFeatures": {
        "properties": {
